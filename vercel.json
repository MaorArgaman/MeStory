{
  "version": 2,
  "builds": [
    {
      "src": "server/src/server.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "server/src/assets/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/src/server.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/agents/david/run",
      "schedule": "0 4 * * *"
    }
  ]
}
