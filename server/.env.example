# =====================================================================
# MeStory Server - environment template
# =====================================================================
# Copy this file to `.env.local` (or `.env`) and fill in real values.
# Never commit the filled-in copy.
# =====================================================================

# ----- Server -------------------------------------------------------
PORT=5001
# "development" or "production". Production REQUIRES real PayPal creds.
NODE_ENV=development

# ----- Database (Supabase PostgreSQL) -------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Legacy. Not actively used - data layer is Supabase.
MONGODB_URI=mongodb://localhost:27017/mestory

# ----- Authentication -----------------------------------------------
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=60d

# ----- Google Gemini AI ---------------------------------------------
# Required. Powers all AI text/design/TTS features.
GEMINI_API_KEY=your-gemini-api-key

# ----- OpenAI Whisper (voice transcription) -------------------------
# Required for voice writing / voice interview features.
OPENAI_API_KEY=your-openai-api-key

# ----- Google OAuth -------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# =====================================================================
# PayPal - REQUIRED for purchases to work
# =====================================================================
# Get from https://developer.paypal.com/dashboard/applications
# Create TWO apps: one for Sandbox, one for Live. Use Sandbox creds first.
# ---------------------------------------------------------------------
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# "sandbox" for testing. Switch to "live" only for real payments.
PAYPAL_MODE=sandbox
# After registering a webhook in PayPal Dashboard pointing to
# https://your-server/api/webhooks/paypal, copy the Webhook ID here.
# Without it, PayPal events will be DROPPED and subscriptions won't update.
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Frontend (used as PayPal return_url base, and admin recipient)
CLIENT_URL=http://localhost:5173
# Email of PayPal account that receives platform commission share
ADMIN_PAYPAL_EMAIL=admin@your-domain.com

# Mock mode - skips real PayPal entirely. Useful for local dev when you
# don't have sandbox creds yet. Has NO EFFECT in production (NODE_ENV=production).
ENABLE_MOCK_PAYMENTS=false

# =====================================================================
# Plan pricing - DEPRECATED
# =====================================================================
# Pricing now lives in server/src/config/plans.ts as the single source
# of truth. These vars are kept only for backward compatibility while
# legacy callers are migrated. Do not rely on them in new code.
FREE_PLAN_PRICE=0
STANDARD_PLAN_PRICE=25
PREMIUM_PLAN_PRICE=65
FREE_PLAN_CREDITS=50
STANDARD_PLAN_CREDITS=700
PREMIUM_PLAN_CREDITS=2500

# =====================================================================
# Marketplace commission - DEPRECATED
# =====================================================================
# Commission split is now per-plan (see plans.ts). These globals only
# apply to the legacy 50/50 fallback.
AUTHOR_REVENUE_PERCENTAGE=50
PLATFORM_REVENUE_PERCENTAGE=50
# Minimum balance (USD) before authors can request a payout.
PAYOUT_THRESHOLD=10

# ----- File Upload --------------------------------------------------
MAX_FILE_SIZE=50MB
UPLOAD_DIR=./uploads

# ----- Rate Limiting ------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ----- Email --------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=MeStory <noreply@mestory.com>
